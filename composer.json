{
    "name": "rlorakib/munafa",
    "description": "COD Profit & Return Tracker for WooCommerce",
    "type": "wordpress-plugin",
    "version": "0.1.0",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "~9.6"
    },
    "autoload": {
        "psr-4": {
            "Munafa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Munafa\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "phpunit"
    }
}
